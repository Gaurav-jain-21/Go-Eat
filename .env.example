# MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/goeat?retryWrites=true&w=majority

# Shared auth
JWT_SECRET=change_this_to_a_long_random_secret

# Frontend
VITE_API_URL=http://localhost:5000

# Internal service URLs used by api-gateway and admin-service inside Docker
AUTH_SERVICE_URL=http://auth-service:5001
USER_SERVICE_URL=http://user-service:5002
HOTEL_SERVICE_URL=http://hotel-service:5003
FOOD_SERVICE_URL=http://food-service:5004
CART_SERVICE_URL=http://cart-service:5005
ORDER_SERVICE_URL=http://order-service:5006
PAYMENT_SERVICE_URL=http://payment-service:5007
AI_SERVICE_URL=http://ai-service:8000
NOTIFICATION_SERVICE_URL=http://notification-service:5009
ADMIN_SERVICE_URL=http://admin-service:5010
REVIEW_SERVICE_URL=http://review-rating-service:5011
DELIVERY_SERVICE_URL=http://delivery-tracking-service:5012
RECOMMENDATION_SERVICE_URL=http://recommendation-service:5013

# Optional database names used by ai-service.
# Keep these equal to the database name in MONGO_URI unless you split services by DB.
AUTH_DB_NAME=goeat
FOOD_DB_NAME=goeat
HOTEL_DB_NAME=goeat
ORDER_DB_NAME=goeat
PAYMENT_DB_NAME=goeat
REVIEW_DB_NAME=goeat

# Optional integrations
EMAIL_USER=
EMAIL_PASS=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
GROQ_API_KEY= #https://groq.com/   visit to get your API key
GROQ_MODEL=llama-3.3-70b-versatile
